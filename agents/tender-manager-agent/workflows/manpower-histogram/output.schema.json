{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/tender-manager-agent/workflows/manpower-histogram/output.schema.json",
  "title": "Manpower Histogram Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "manpower-histogram"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "periodized_manpower_data",
                  "histogram_rendering_specification",
                  "trade_role_and_location_summaries",
                  "peak_and_mobilization_analysis",
                  "resource_reconciliation",
                  "assumption_and_exception_report"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
