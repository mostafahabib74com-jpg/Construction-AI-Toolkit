{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/tender-manager-agent/schemas/workflow.schema.json",
  "title": "Tender Manager Workflow Envelopes",
  "$defs": {
    "inputEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tender", "execution", "documents", "domain_artifacts", "workflow_inputs"],
      "properties": {
        "tender": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tender_id", "name", "client", "reference", "version", "submission_deadline", "time_zone", "currency", "language"],
          "properties": {
            "tender_id": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "client": {"type": "string", "minLength": 1},
            "reference": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "submission_deadline": {"type": "string", "format": "date-time"},
            "time_zone": {"type": "string", "minLength": 1},
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
            "language": {"type": "string", "minLength": 2},
            "submission_method": {"type": ["string", "null"]}
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_version", "tender_version", "source_cutoff", "latest_addendum_id"],
          "properties": {
            "workflow_version": {"const": "0.1.0"},
            "tender_version": {"type": "string", "minLength": 1},
            "source_cutoff": {"type": "string", "minLength": 1},
            "latest_addendum_id": {"type": ["string", "null"]},
            "requested_language": {"type": "string", "minLength": 2},
            "due_date": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "documents": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sourceReference"}},
        "domain_artifacts": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifactReference"}},
        "workflow_inputs": {"type": "object"},
        "upstream_outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workflow_id", "version", "approval_status", "artifact_reference"],
            "properties": {
              "workflow_id": {"type": "string"},
              "version": {"type": "string"},
              "approval_status": {"enum": ["approved", "conditionally_approved", "draft"]},
              "artifact_reference": {"type": "string"}
            }
          }
        },
        "requested_formats": {
          "type": "array",
          "items": {"enum": ["json", "markdown", "docx", "xlsx", "pdf", "zip-manifest"]},
          "minItems": 1
        }
      }
    },
    "outputEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "workflow_version", "status", "executive_summary", "tender_reference", "source_register", "domain_artifacts", "deliverables", "findings", "registers", "review"],
      "properties": {
        "workflow_id": {"type": "string"},
        "workflow_version": {"const": "0.1.0"},
        "status": {"enum": ["complete", "incomplete", "blocked", "requires_review"]},
        "executive_summary": {"type": "string", "minLength": 1},
        "tender_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tender_id", "version", "source_cutoff", "latest_addendum_id"],
          "properties": {
            "tender_id": {"type": "string"},
            "version": {"type": "string"},
            "source_cutoff": {"type": "string"},
            "latest_addendum_id": {"type": ["string", "null"]}
          }
        },
        "source_register": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sourceReference"}},
        "domain_artifacts": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifactReference"}},
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "artifact_reference", "status"],
            "properties": {
              "type": {"type": "string"},
              "artifact_reference": {"type": ["string", "null"]},
              "status": {"enum": ["draft", "generated", "validated", "approved", "blocked"]},
              "notes": {"type": ["string", "null"]}
            }
          }
        },
        "findings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/finding"}},
        "registers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clarifications", "rfis", "assumptions", "exclusions", "qualifications", "deviations", "risks", "actions", "decisions"],
          "properties": {
            "clarifications": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "rfis": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "assumptions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "exclusions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "qualifications": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "deviations": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "risks": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "actions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "decisions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}}
          }
        },
        "quality_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate", "status"],
            "properties": {
              "gate": {"type": "string"},
              "status": {"enum": ["passed", "failed", "not_applicable", "requires_review"]},
              "evidence": {"type": ["string", "null"]}
            }
          }
        },
        "review": {"$ref": "common.schema.json#/$defs/review"}
      }
    }
  }
}
