{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/tender-manager-agent/workflows/project-schedule/output.schema.json",
  "title": "Tender Project Schedule Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "project-schedule"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "tender_schedule_package_index",
                  "milestone_and_phase_schedule",
                  "schedule_narrative_cross_reference",
                  "schedule_deliverable_specification",
                  "proposal_schedule_reconciliation",
                  "schedule_compliance_report"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
