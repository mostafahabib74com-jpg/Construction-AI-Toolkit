{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/contracts/v1/core/error.schema.json",
  "title": "Platform Issue",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "severity", "recoverable"],
  "properties": {
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "message": {"type": "string", "minLength": 1},
    "severity": {"enum": ["info", "warning", "error", "blocker"]},
    "recoverable": {"type": "boolean"},
    "path": {"type": ["string", "null"]},
    "remediation": {"type": ["string", "null"]},
    "details": {"type": "object"}
  }
}
