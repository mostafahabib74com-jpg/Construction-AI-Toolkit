{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/contracts/v1/domain/schedule.schema.json",
  "title": "Schedule Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schedule_id", "project_id", "version", "data_date", "status", "wbs", "activities", "calendars"],
  "properties": {
    "schedule_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "data_date": {"type": "string", "format": "date-time"},
    "status": {"enum": ["draft", "release_candidate", "approved", "update", "forecast", "recovery", "scenario", "impacted"]},
    "wbs": {"type": "array", "items": {"$ref": "https://construction-ai-toolkit.dev/contracts/v1/domain/wbs.schema.json"}, "minItems": 1},
    "activities": {"type": "array", "items": {"$ref": "https://construction-ai-toolkit.dev/contracts/v1/domain/activity.schema.json"}, "minItems": 1},
    "calendars": {"type": "array", "items": {"$ref": "https://construction-ai-toolkit.dev/contracts/v1/domain/calendar.schema.json"}, "minItems": 1}
  }
}
