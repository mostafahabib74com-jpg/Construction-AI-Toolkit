{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/contracts/v1/core/workflow-request.schema.json",
  "title": "Workflow Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "project", "selector", "inputs"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "project": {"$ref": "https://construction-ai-toolkit.dev/contracts/v1/core/project.schema.json"},
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "workflow_id": {"type": "string", "minLength": 1},
        "user_request": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {"type": "object"},
    "upstream_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "version"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      },
      "uniqueItems": true
    },
    "requested_formats": {
      "type": "array",
      "items": {"enum": ["json", "markdown", "docx", "xlsx", "pdf", "xer", "p6-xml", "zip-manifest"]},
      "uniqueItems": true
    }
  }
}
