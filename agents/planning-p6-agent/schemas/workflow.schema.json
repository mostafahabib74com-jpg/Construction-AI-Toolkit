{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/schemas/workflow.schema.json",
  "title": "Planning Workflow Envelopes",
  "$defs": {
    "inputEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "execution", "documents", "schedules", "workflow_inputs"],
      "properties": {
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "name", "location", "time_zone"],
          "properties": {
            "project_id": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "location": {"type": "string", "minLength": 1},
            "time_zone": {"type": "string", "minLength": 1},
            "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_version", "schedule_version", "data_date", "source_cutoff"],
          "properties": {
            "workflow_version": {"const": "0.1.0"},
            "schedule_version": {"type": "string", "minLength": 1},
            "data_date": {"type": "string", "format": "date-time"},
            "source_cutoff": {"type": "string", "minLength": 1},
            "requested_language": {"type": "string", "minLength": 2}
          }
        },
        "documents": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/sourceReference"}
        },
        "schedules": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/scheduleReference"}
        },
        "workflow_inputs": {"type": "object"},
        "upstream_outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workflow_id", "version", "approval_status"],
            "properties": {
              "workflow_id": {"type": "string"},
              "version": {"type": "string"},
              "approval_status": {"enum": ["approved", "conditionally_approved", "draft"]},
              "artifact_reference": {"type": ["string", "null"]}
            }
          }
        },
        "requested_formats": {
          "type": "array",
          "items": {"enum": ["json", "markdown", "docx", "xlsx", "pdf", "xer", "p6-xml"]},
          "minItems": 1
        }
      }
    },
    "outputEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "workflow_version", "status", "executive_summary", "schedule_references", "source_register", "deliverables", "findings", "registers", "review"],
      "properties": {
        "workflow_id": {"type": "string"},
        "workflow_version": {"const": "0.1.0"},
        "status": {"enum": ["complete", "incomplete", "blocked", "requires_review"]},
        "executive_summary": {"type": "string", "minLength": 1},
        "schedule_references": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/scheduleReference"}},
        "source_register": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sourceReference"}},
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "artifact_reference", "status"],
            "properties": {
              "type": {"type": "string"},
              "artifact_reference": {"type": ["string", "null"]},
              "status": {"enum": ["draft", "generated", "validated", "approved", "blocked"]},
              "notes": {"type": ["string", "null"]}
            }
          }
        },
        "findings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/finding"}},
        "registers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assumptions", "constraints", "missing_information", "changes", "actions"],
          "properties": {
            "assumptions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "constraints": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "missing_information": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "changes": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
            "actions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}}
          }
        },
        "quality_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate", "status"],
            "properties": {
              "gate": {"type": "string"},
              "status": {"enum": ["passed", "failed", "not_applicable", "requires_review"]},
              "evidence": {"type": ["string", "null"]}
            }
          }
        },
        "review": {"$ref": "common.schema.json#/$defs/review"}
      }
    }
  }
}
