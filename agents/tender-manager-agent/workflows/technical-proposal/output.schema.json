{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/tender-manager-agent/workflows/technical-proposal/output.schema.json",
  "title": "Technical Proposal Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "technical-proposal"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "technical_proposal_outline",
                  "draft_technical_proposal",
                  "figure_table_and_evidence_schedule",
                  "section_review_tracker",
                  "technical_consistency_report",
                  "rendering_specification"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
