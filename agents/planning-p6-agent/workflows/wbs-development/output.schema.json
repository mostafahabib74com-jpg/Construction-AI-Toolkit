{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/workflows/wbs-development/output.schema.json",
  "title": "WBS Development Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "wbs-development"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "complete_wbs",
                  "wbs_dictionary",
                  "coding_structure",
                  "scope_coverage_matrix",
                  "wbs_exception_register"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
