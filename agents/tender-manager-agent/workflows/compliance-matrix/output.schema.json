{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/tender-manager-agent/workflows/compliance-matrix/output.schema.json",
  "title": "Compliance Matrix Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "compliance-matrix"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "detailed_compliance_matrix",
                  "requirements_dashboard",
                  "responsibility_matrix",
                  "evidence_cross_reference",
                  "noncompliance_report",
                  "addendum_impact_reconciliation"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
