{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/contracts/v1/domain/calendar.schema.json",
  "title": "Schedule Calendar",
  "type": "object",
  "additionalProperties": false,
  "required": ["calendar_id", "name", "time_zone", "hours_per_day", "working_days"],
  "properties": {
    "calendar_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "time_zone": {"type": "string", "minLength": 1},
    "hours_per_day": {"type": "number", "exclusiveMinimum": 0, "maximum": 24},
    "working_days": {
      "type": "array",
      "items": {"enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "working"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "working": {"type": "boolean"},
          "hours": {"type": ["number", "null"], "minimum": 0, "maximum": 24},
          "reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
