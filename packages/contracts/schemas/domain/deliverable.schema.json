{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/contracts/v1/domain/deliverable.schema.json",
  "title": "Deliverable",
  "type": "object",
  "additionalProperties": false,
  "required": ["deliverable_id", "name", "deliverable_type", "status", "mandatory_fields"],
  "properties": {
    "deliverable_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "deliverable_type": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "draft", "generated", "validated", "approved", "blocked", "submitted"]},
    "mandatory_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "missing_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "field_values": {"type": "object"},
    "artifact_reference": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "version"],
          "properties": {
            "artifact_id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        {"type": "null"}
      ]
    },
    "due_at": {"type": ["string", "null"], "format": "date-time"},
    "review": {"$ref": "https://construction-ai-toolkit.dev/contracts/v1/core/review.schema.json"}
  }
}
