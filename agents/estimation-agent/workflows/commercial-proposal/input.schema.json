{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/estimation-agent/workflows/commercial-proposal/input.schema.json",
  "title": "Commercial Proposal Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "execution",
    "documents",
    "workflow_inputs"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "name",
        "location",
        "currency",
        "unit_system"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "unit_system": {
          "enum": [
            "SI",
            "imperial",
            "mixed"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "workflow_version",
        "document_revision_cutoff",
        "requested_language"
      ],
      "properties": {
        "workflow_version": {
          "const": "0.1.0"
        },
        "document_revision_cutoff": {
          "type": "string",
          "minLength": 1
        },
        "requested_language": {
          "type": "string",
          "minLength": 2
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "../../schemas/common.schema.json#/$defs/documentReference"
      }
    },
    "workflow_inputs": {
      "type": "object",
      "required": [
        "approved_estimate",
        "approved_workbook",
        "client_pricing_forms",
        "approved_commercial_basis",
        "approved_bid_adjustments"
      ],
      "properties": {
        "approved_estimate": {
          "type": [
            "object",
            "array",
            "string"
          ],
          "description": "Controlled input: approved estimate"
        },
        "approved_workbook": {
          "type": [
            "object",
            "array",
            "string"
          ],
          "description": "Controlled input: approved workbook"
        },
        "client_pricing_forms": {
          "type": [
            "object",
            "array",
            "string"
          ],
          "description": "Controlled input: client pricing forms"
        },
        "approved_commercial_basis": {
          "type": [
            "object",
            "array",
            "string"
          ],
          "description": "Controlled input: approved commercial basis"
        },
        "approved_bid_adjustments": {
          "type": [
            "object",
            "array",
            "string"
          ],
          "description": "Controlled input: approved bid adjustments"
        }
      }
    },
    "upstream_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "workflow_id",
          "version",
          "approval_status"
        ],
        "properties": {
          "workflow_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "approval_status": {
            "enum": [
              "approved",
              "conditionally_approved",
              "draft"
            ]
          },
          "artifact_reference": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "requested_formats": {
      "type": "array",
      "items": {
        "enum": [
          "json",
          "markdown",
          "docx",
          "xlsx",
          "pdf"
        ]
      },
      "minItems": 1
    }
  }
}
