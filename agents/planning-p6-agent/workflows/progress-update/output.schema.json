{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/workflows/progress-update/output.schema.json",
  "title": "Progress Update Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "progress-update"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "updated_schedule_model",
                  "progress_register",
                  "variance_report",
                  "forecast_milestones",
                  "schedule_quality_report",
                  "schedule_change_log"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
