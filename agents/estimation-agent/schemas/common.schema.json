{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/estimation-agent/schemas/common.schema.json",
  "title": "Estimation Agent Common Definitions",
  "$defs": {
    "documentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "revision", "location"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "document_number": {"type": ["string", "null"]},
        "revision": {"type": "string", "minLength": 1},
        "date": {"type": ["string", "null"], "format": "date"},
        "location": {"type": "string", "minLength": 1},
        "extraction_method": {"enum": ["native", "ocr", "structured_import", "user_statement"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "number"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "pricing_date": {"type": ["string", "null"], "format": "date"},
        "exchange_rate_source": {"type": ["string", "null"]}
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "basis"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "basis": {"enum": ["measured", "calculated", "client_boq", "model", "assumed", "allowance", "provisional"]},
        "source": {"$ref": "#/$defs/documentReference"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "description", "basis", "severity", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "basis": {"enum": ["source_fact", "deterministic_calculation", "quotation", "approved_company_data", "user_statement", "assumption", "recommendation"]},
        "source": {"$ref": "#/$defs/documentReference"},
        "severity": {"enum": ["critical", "high", "medium", "low", "information"]},
        "cost_impact": {"$ref": "#/$defs/money"},
        "schedule_impact_days": {"type": ["number", "null"]},
        "recommended_action": {"type": ["string", "null"]},
        "owner_role": {"type": ["string", "null"]},
        "due_date": {"type": ["string", "null"], "format": "date"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["open", "answered", "accepted", "rejected", "closed", "requires_review"]}
      }
    },
    "registerItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/documentReference"},
        "impact": {"type": ["string", "null"]},
        "treatment": {"type": ["string", "null"]},
        "owner_role": {"type": ["string", "null"]},
        "status": {"enum": ["draft", "open", "approved", "rejected", "closed"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_roles", "status"],
      "properties": {
        "required_roles": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "status": {"enum": ["not_started", "in_review", "approved", "rejected", "revision_required"]},
        "comments": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
