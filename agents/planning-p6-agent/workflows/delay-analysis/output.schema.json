{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/workflows/delay-analysis/output.schema.json",
  "title": "Delay Analysis Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "delay-analysis"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "delay_event_chronology",
                  "schedule_variance_analysis",
                  "critical_path_analysis",
                  "method_selection_report",
                  "limitations_and_entitlement_boundary"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
