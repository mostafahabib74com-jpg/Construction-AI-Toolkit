{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/workflows/baseline-schedule-generation/output.schema.json",
  "title": "Baseline Schedule Generation Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "baseline-schedule-generation"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "baseline_schedule_model",
                  "p6_import_package",
                  "basis_of_schedule",
                  "schedule_narrative",
                  "cpm_report",
                  "schedule_quality_report"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
