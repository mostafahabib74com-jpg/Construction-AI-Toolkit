{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/workflows/activity-list-development/output.schema.json",
  "title": "Activity List Development Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "activity-list-development"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "activity_register",
                  "activity_dictionary",
                  "milestone_register",
                  "activity_source_traceability",
                  "schedule_assumption_register"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
