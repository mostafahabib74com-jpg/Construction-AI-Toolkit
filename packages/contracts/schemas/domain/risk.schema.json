{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/contracts/v1/domain/risk.schema.json",
  "title": "Risk",
  "type": "object",
  "additionalProperties": false,
  "required": ["risk_id", "description", "category", "probability", "impact", "status"],
  "properties": {
    "risk_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "impact": {"enum": ["very_low", "low", "medium", "high", "very_high"]},
    "owner": {"type": ["string", "null"]},
    "response": {"type": ["string", "null"]},
    "status": {"enum": ["open", "mitigating", "accepted", "closed", "escalated"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
