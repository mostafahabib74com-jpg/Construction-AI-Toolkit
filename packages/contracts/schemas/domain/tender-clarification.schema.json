{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/contracts/v1/domain/tender-clarification.schema.json",
  "title": "Tender Clarification",
  "type": "object",
  "additionalProperties": false,
  "required": ["clarification_id", "subject", "question", "category", "status"],
  "properties": {
    "clarification_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "category": {"enum": ["technical", "commercial", "contractual", "submission", "administrative"]},
    "status": {"enum": ["draft", "internal_review", "approved_for_issue", "issued", "answered", "closed", "withdrawn"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "response": {"type": ["string", "null"]},
    "response_source_id": {"type": ["string", "null"]}
  }
}
