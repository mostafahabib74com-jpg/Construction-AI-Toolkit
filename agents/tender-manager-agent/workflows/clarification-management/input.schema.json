{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/tender-manager-agent/workflows/clarification-management/input.schema.json",
  "title": "Clarification Management Input",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/inputEnvelope"
    },
    {
      "type": "object",
      "required": [
        "workflow_inputs"
      ],
      "properties": {
        "workflow_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved_compliance_matrix",
            "gap_and_conflict_registers",
            "query_and_communication_rules",
            "existing_clarifications"
          ],
          "properties": {
            "approved_compliance_matrix": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: approved compliance matrix"
            },
            "gap_and_conflict_registers": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: gap and conflict registers"
            },
            "query_and_communication_rules": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: query and communication rules"
            },
            "existing_clarifications": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: existing clarifications"
            }
          }
        }
      }
    }
  ]
}
