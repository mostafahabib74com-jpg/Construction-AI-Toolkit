{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/workflows/material-submittal-schedule/output.schema.json",
  "title": "Material Submittal Schedule Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "material-submittal-schedule"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "material_submittal_schedule",
                  "review_cycle_register",
                  "p6_activity_mapping",
                  "late_material_risk_report"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
