{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/estimation-agent/schemas/estimate.schema.json",
  "title": "Construction Estimate",
  "type": "object",
  "additionalProperties": false,
  "required": ["estimate_id", "version", "project", "basis", "cost_items", "summary", "registers", "review"],
  "properties": {
    "estimate_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["working", "review", "approved", "superseded", "withdrawn"]},
    "project": {
      "type": "object",
      "required": ["name", "location", "currency", "unit_system"],
      "properties": {
        "name": {"type": "string"},
        "location": {"type": "string"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "unit_system": {"enum": ["SI", "imperial", "mixed"]}
      }
    },
    "basis": {
      "type": "object",
      "required": ["purpose", "estimate_class", "pricing_date", "document_cutoff", "measurement_profile"],
      "properties": {
        "purpose": {"type": "string"},
        "estimate_class": {"type": "string"},
        "pricing_date": {"type": "string", "format": "date"},
        "document_cutoff": {"type": "string"},
        "measurement_profile": {"type": "string"},
        "tax_profile": {"type": ["string", "null"]},
        "escalation_profile": {"type": ["string", "null"]}
      }
    },
    "cost_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "description", "cbs_code", "quantity", "base_rate", "extension", "source_type"],
        "properties": {
          "item_id": {"type": "string"},
          "boq_reference": {"type": ["string", "null"]},
          "wbs_code": {"type": ["string", "null"]},
          "cbs_code": {"type": "string"},
          "description": {"type": "string"},
          "quantity": {"$ref": "common.schema.json#/$defs/quantity"},
          "base_rate": {"$ref": "common.schema.json#/$defs/money"},
          "extension": {"$ref": "common.schema.json#/$defs/money"},
          "source_type": {"enum": ["quotation", "company_rate", "historical", "benchmark", "build_up", "allowance", "provisional"]},
          "source_reference": {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["direct_cost", "indirect_cost", "risk", "overhead", "profit", "tax", "final_bid_price", "currency"],
      "properties": {
        "direct_cost": {"type": "number"},
        "indirect_cost": {"type": "number"},
        "risk": {"type": "number"},
        "escalation": {"type": "number"},
        "overhead": {"type": "number"},
        "profit": {"type": "number"},
        "discount": {"type": "number"},
        "tax": {"type": "number"},
        "final_bid_price": {"type": "number"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "reconciled": {"type": "boolean"}
      }
    },
    "registers": {
      "type": "object",
      "required": ["assumptions", "exclusions", "qualifications", "missing_information", "risks"],
      "properties": {
        "assumptions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
        "exclusions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
        "qualifications": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
        "missing_information": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/registerItem"}},
        "risks": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/finding"}}
      }
    },
    "review": {"$ref": "common.schema.json#/$defs/review"}
  }
}
