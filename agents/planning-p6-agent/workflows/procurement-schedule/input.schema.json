{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/workflows/procurement-schedule/input.schema.json",
  "title": "Procurement Schedule Input",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/inputEnvelope"
    },
    {
      "type": "object",
      "required": [
        "workflow_inputs"
      ],
      "properties": {
        "workflow_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_schedule",
            "procurement_packages",
            "lead_time_basis",
            "contract_strategy"
          ],
          "properties": {
            "baseline_schedule": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: baseline schedule"
            },
            "procurement_packages": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: procurement packages"
            },
            "lead_time_basis": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: lead time basis"
            },
            "contract_strategy": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: contract strategy"
            }
          }
        }
      }
    }
  ]
}
