{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/workflows/resource-loading/output.schema.json",
  "title": "Resource Loading Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "resource-loading"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "resource_dictionary",
                  "resource_assignment_register",
                  "resource_histograms",
                  "overallocation_report",
                  "resource_loaded_schedule"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
