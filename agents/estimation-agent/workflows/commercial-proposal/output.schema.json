{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/estimation-agent/workflows/commercial-proposal/output.schema.json",
  "title": "Commercial Proposal Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "workflow_version",
    "status",
    "executive_summary",
    "source_register",
    "deliverables",
    "findings",
    "registers",
    "review"
  ],
  "properties": {
    "workflow_id": {
      "const": "commercial-proposal"
    },
    "workflow_version": {
      "const": "0.1.0"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete",
        "blocked",
        "requires_review"
      ]
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1
    },
    "source_register": {
      "type": "array",
      "items": {
        "$ref": "../../schemas/common.schema.json#/$defs/documentReference"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "artifact_reference",
          "status"
        ],
        "properties": {
          "type": {
            "enum": [
              "commercial_offer_letter",
              "completed_pricing_schedules",
              "bid_price_summary",
              "commercial_registers",
              "options_and_dayworks",
              "commercial_basis_statement",
              "reconciliation_report",
              "approval_route"
            ]
          },
          "artifact_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "generated",
              "validated",
              "approved",
              "blocked"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "../../schemas/common.schema.json#/$defs/finding"
      }
    },
    "registers": {
      "type": "object",
      "required": [
        "missing_information",
        "assumptions",
        "exclusions",
        "qualifications",
        "actions"
      ],
      "properties": {
        "missing_information": {
          "type": "array",
          "items": {
            "$ref": "../../schemas/common.schema.json#/$defs/registerItem"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "../../schemas/common.schema.json#/$defs/registerItem"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "../../schemas/common.schema.json#/$defs/registerItem"
          }
        },
        "qualifications": {
          "type": "array",
          "items": {
            "$ref": "../../schemas/common.schema.json#/$defs/registerItem"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "../../schemas/common.schema.json#/$defs/registerItem"
          }
        }
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "status"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_applicable",
              "requires_review"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "review": {
      "$ref": "../../schemas/common.schema.json#/$defs/review"
    }
  }
}
