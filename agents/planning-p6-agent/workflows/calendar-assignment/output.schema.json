{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/workflows/calendar-assignment/output.schema.json",
  "title": "Calendar Assignment Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "calendar-assignment"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "calendar_register",
                  "calendar_assignment_matrix",
                  "calendar_exception_register",
                  "calendar_narrative"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
