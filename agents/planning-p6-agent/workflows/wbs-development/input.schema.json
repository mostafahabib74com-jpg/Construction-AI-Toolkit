{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/workflows/wbs-development/input.schema.json",
  "title": "WBS Development Input",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/inputEnvelope"
    },
    {
      "type": "object",
      "required": [
        "workflow_inputs"
      ],
      "properties": {
        "workflow_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_scope",
            "project_breakdown_requirements",
            "milestone_register",
            "coding_rules"
          ],
          "properties": {
            "contract_scope": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: contract scope"
            },
            "project_breakdown_requirements": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: project breakdown requirements"
            },
            "milestone_register": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: milestone register"
            },
            "coding_rules": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Controlled input: coding rules"
            }
          }
        }
      }
    }
  ]
}
