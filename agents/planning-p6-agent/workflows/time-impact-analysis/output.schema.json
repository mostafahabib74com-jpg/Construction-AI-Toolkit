{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-ai-toolkit.dev/agents/planning-p6-agent/workflows/time-impact-analysis/output.schema.json",
  "title": "Time Impact Analysis Output",
  "allOf": [
    {
      "$ref": "../../schemas/workflow.schema.json#/$defs/outputEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "workflow_id": {
          "const": "time-impact-analysis"
        },
        "workflow_version": {
          "const": "0.1.0"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "unimpacted_schedule_model",
                  "fragnet_register",
                  "impacted_schedule_model",
                  "impact_comparison",
                  "time_impact_analysis_report",
                  "sensitivity_results"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
